# Vercel AI Gateway — required for hosted YardDog turns (no ModelHitch).
# Eve docs also accept a linked project OIDC token (VERCEL_OIDC_TOKEN).
AI_GATEWAY_API_KEY=

# Optional lane overrides (comma-separated provider/model ids)
# YARDDOG_FAST_POOL=google/gemini-2.5-flash,openai/gpt-4o-mini
# YARDDOG_HIGH_POOL=anthropic/claude-sonnet-4.6,openai/gpt-4o
# YARDDOG_FAST_MODEL=google/gemini-2.5-flash
# YARDDOG_HIGH_MODEL=anthropic/claude-sonnet-4.6
