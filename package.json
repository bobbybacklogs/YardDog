{
  "name": "yarddog",
  "version": "0.1.0",
  "description": "No-nonsense multi-agent orchestration harness built directly on top of ModelHitch.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "bin": {
    "yarddog": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/cli.ts --compile --outfile bin/yarddog",
    "install:global": "bun run build && bun link"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentui/core": "^0.1.28",
    "just-bash": "^3.4.2",
    "modelhitch": "^0.14.7",
    "portage-cli": "^0.1.4",
    "skillswap": "^0.2.0",
    "smol-toml": "^1.8.0"
  },
  "overrides": {
    "minimatch": "9.0.5"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.0"
  }
}
